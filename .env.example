# Public callback configuration; register this exact URL in the Yahoo app.
YAHOO_REDIRECT_URI=https://rogeliomc.com/api/redirect

# Set real values only in Netlify's server-side environment variables and in an ignored local .env file.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_ADMIN_PASSWORD=

# Independent signing key for owner-only Front Office sessions and OAuth state (at least 32 random characters).
# Configure only for the production deploy context; keep it out of Git and deploy previews.
FRONT_OFFICE_SESSION_SECRET=
